{
  "name": "nodebraid",
  "version": "0.1.0",
  "private": true,
  "description": "A calm desktop client for everyday Git work.",
  "main": "src/main/index.js",
  "author": "Nodebraid contributors",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:unit": "node --test test/unit-*.test.js test/static.test.js",
    "test:integration": "node --test test/integration-git.test.js",
    "icons": "node scripts/generate-icons.js",
    "pack": "npm run icons && electron-builder --dir",
    "dist": "npm run icons && electron-builder",
    "source:archive": "node scripts/create-source-archive.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "assets/**/*",
    "src/**/*",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.nodebraid.desktop",
    "productName": "Nodebraid",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "electron@44.0.0": true
  }
}
